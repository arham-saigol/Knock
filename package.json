{
  "name": "knock",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "vercel:build": "npx convex deploy --cmd 'npm run build'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arham-saigol/Knock.git"
  },
  "bugs": {
    "url": "https://github.com/arham-saigol/Knock/issues"
  },
  "homepage": "https://github.com/arham-saigol/Knock#readme",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.62",
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.5.22",
    "ai": "^6.0.234",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.9",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "private": true,
  "overrides": {
    "sharp": "$sharp",
    "postcss": "$postcss"
  }
