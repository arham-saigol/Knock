# Vercel and local Next.js
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CONVEX_URL=https://replace-me.convex.cloud

# Server-only Vercel SMTP settings
SPACEMAIL_SMTP_HOST=mail.spacemail.com
SPACEMAIL_SMTP_PORT=465
SPACEMAIL_SMTP_USER=primary-mailbox@example.com
SPACEMAIL_SMTP_PASSWORD=replace_me
SPACEMAIL_ALLOWED_SENDERS=arham@example.com,hello@example.com

# Optional on Vercel when `npm run vercel:build` deploys Convex
CONVEX_DEPLOY_KEY=

# Convex Cloud environment variables, set with `npx convex env set`
CLERK_JWT_ISSUER_DOMAIN=https://replace-me.clerk.accounts.dev
PRODUCT_HUNT_TOKEN=replace_me
OPENCODE_GO_API_KEY=replace_me
DEEPSEEK_API_KEY=replace_me
TINYFISH_API_KEY=replace_me
FIRECRAWL_API_KEY=fc-replace_me
FIRECRAWL_WEBHOOK_SECRET=replace_me
CONVEX_SITE_URL=https://replace-me.convex.site
KNOCK_ALLOWED_USER_IDS=user_replace_me
